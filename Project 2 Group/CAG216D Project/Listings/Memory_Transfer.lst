A51 MACRO ASSEMBLER  MEMORY_TRANSFER                                                      04/07/2025 21:08:34 PAGE     1


MACRO ASSEMBLER A51 V8.2.7.0
OBJECT MODULE PLACED IN .\Objects\Memory_Transfer.obj
ASSEMBLER INVOKED BY: C:\Keil_v5\C51\BIN\A51.EXE Memory_Transfer.asm SET(SMALL) DEBUG PRINT(.\Listings\Memory_Transfer.l
                      st) OBJECT(.\Objects\Memory_Transfer.obj) EP

LOC  OBJ            LINE     SOURCE

0000                   1     ORG 0000H         ; Start of code memory
                       2     
0000                   3     START:
0000 7800              4         MOV R0, #00H  ; R0 will be used as offset (0 to 9)
0002 7A0A              5         MOV R2, #0AH  ; R2 = 10 bytes to copy
                       6     
0004                   7     TRANSFER_LOOP:
                       8         ; Load source address = 8000H + R0
0004 758308            9         MOV DPH, #08H   ; Load DPH for source address (high byte 0800H to 0809H)
0007 8882             10         MOV DPL, R0     ; Load DPL with the R0 value (0 to 9 for 8000H to 8009H)
0009 E0               11         MOVX A, @DPTR   ; Read from external memory at 8000H + offset
000A FB               12         MOV R3, A       ; Save data temporarily in R3
                      13     
                      14         ; Load destination address = 9000H + R0
000B 758309           15         MOV DPH, #09H   ; Load DPH for destination address (9000H to 9009H)
000E 8882             16         MOV DPL, R0     ; Load DPL with the R0 value (0 to 9 for 9000H to 9009H)
0010 EB               17         MOV A, R3       ; Load A with the data read from source memory
0011 F0               18         MOVX @DPTR, A   ; Write data to external memory at 9000H + offset
                      19     
0012 08               20         INC R0          ; Move to the next byte (increment R0)
0013 DAEF             21         DJNZ R2, TRANSFER_LOOP  ; Decrement R2, loop until 10 bytes are copied
                      22     
0015 80FE             23         SJMP $          ; Infinite loop to stop program here
                      24     
                      25     END                 ; End of program
